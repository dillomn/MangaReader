# MangaVa runtime config — copy to .env on the host that runs the container.
# .env is gitignored (see .gitignore ".env.*"); never commit real values.

# Jellyfin server used for login. Empty = local accounts only.
JELLYFIN_URL=http://192.168.1.196:8096

# Public origin(s) allowed to call the API. Comma-separated. Only needed when
# the frontend is served from a different origin than the API.
ALLOWED_ORIGINS=https://manga.aperturelabs.au

# Optional. If unset, a secret is auto-generated and persisted to the
# mangva-data volume (existing logins stay valid across restarts).
# JWT_SECRET=

# Container timezone.
TZ=Australia/Sydney
